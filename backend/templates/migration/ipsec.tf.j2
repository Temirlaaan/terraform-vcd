{% if ipsec_tunnels or ipsec_skipped %}
# ---------------------------------------------------------------------------
#  IPsec VPN tunnels
#
#  Every tunnel is created disabled. A VPN tunnel is a live session with a
#  third party, not an idempotent rule: bringing one up while the source
#  edge still holds it makes both ends negotiate with the same peer from
#  different addresses. Enable them one at a time during cutover and watch
#  the SA come up.
#
#  Pre-shared keys arrive through TF_VAR_psk_* and are never written here.
# ---------------------------------------------------------------------------
{% endif %}
{% for t in ipsec_skipped %}
# SKIPPED: {{ t.name | hcl_escape }}
{% for reason in t.unsupported %}
#   - {{ reason | hcl_escape }}
{% endfor %}
#   This tunnel needs a decision before it can move. Nothing is generated
#   for it, so applying this file leaves it behind on the source edge.
{% endfor %}

{% for t in ipsec_tunnels %}
variable "psk_{{ t.slug }}" {
  type        = string
  sensitive   = true
  description = "Pre-shared key for tunnel {{ t.name | hcl_escape }}"
}

resource "vcd_nsxt_ipsec_vpn_tunnel" "{{ t.slug }}" {
  org             = var.target_org
  edge_gateway_id = var.target_edge_id

  name        = "{{ t.name | hcl_escape }}"
{% if t.description %}
  description = "{{ t.description | hcl_escape }}"
{% endif %}

  # Switched on per tunnel during cutover, never by this file.
  enabled = false

  local_ip_address = "{{ t.local_ip | hcl_escape }}"
  local_networks   = [{{ t.local_networks | map('tojson') | join(', ') }}]

  remote_ip_address = "{{ t.peer_ip | hcl_escape }}"
  remote_networks   = [{{ t.remote_networks | map('tojson') | join(', ') }}]
{% if t.remote_id %}
  # The peer sits behind NAT and announces this identity rather than its
  # public address. Without it phase 1 fails and the log blames auth.
  remote_id = "{{ t.remote_id | hcl_escape }}"
{% endif %}

  pre_shared_key = var.psk_{{ t.slug }}

  # Algorithms come from the source. The lifetimes and DPD interval do
  # not: NSX-V does not expose them per site. They are written anyway
  # because this block is sent whole — a field left out arrives as 0 and
  # VCD rejects the tunnel. The values are NSX-T's own defaults, so the
  # result matches what the VCD UI would have made.
  security_profile_customization {
    ike_version                  = "{{ t.ike_version }}"
    ike_encryption_algorithms    = ["{{ t.encryption }}"]
    ike_digest_algorithms        = ["{{ t.digest }}"]
    ike_dh_groups                = ["{{ t.dh_group }}"]
    ike_sa_lifetime              = {{ ike_sa_lifetime }}

    tunnel_pfs_enabled           = {{ t.pfs | lower }}
    tunnel_encryption_algorithms = ["{{ t.encryption }}"]
    tunnel_digest_algorithms     = ["{{ t.digest }}"]
    tunnel_dh_groups             = ["{{ t.dh_group }}"]
    tunnel_sa_lifetime           = {{ tunnel_sa_lifetime }}

    # Spelled "internal" by the provider, not "interval".
    dpd_probe_internal           = {{ dpd_probe_interval }}
  }
}

{% endfor %}

{% if ipsec_no_snat %}
# ---------------------------------------------------------------------------
#  NO_SNAT for VPN traffic
#
#  NSX-V ran NAT after the IPsec policy matched, so nothing had to be said.
#  NSX-T evaluates NAT for this traffic too: without these the packets leave
#  through the general internet SNAT rule with a translated source and never
#  enter the tunnel. The tunnel comes up, nothing passes, and it reads as a
#  routing fault rather than a NAT one.
#
#  Enabled on purpose. While a tunnel is disabled nothing routes to its
#  remote networks, so these rules match nothing; they have to be in place
#  the moment it is switched on.
# ---------------------------------------------------------------------------
{% for r in ipsec_no_snat %}
resource "vcd_nsxt_nat_rule" "{{ r.slug }}" {
  org             = var.target_org
  edge_gateway_id = var.target_edge_id

  name                     = "{{ r.name | hcl_escape }}"
  rule_type                = "NO_SNAT"
  internal_address         = "{{ r.internal_address | hcl_escape }}"
  snat_destination_address = "{{ r.destination_address | hcl_escape }}"

  # Lower wins. A general internet SNAT usually sits at the default, and a
  # NO_SNAT sharing that priority would never be reached.
  priority = {{ no_snat_priority }}
  enabled  = true
  logging  = false
}

{% endfor %}
{% endif %}
