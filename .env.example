# =============================================================================
# Terraform VCD Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
#
# Variables marked REQUIRED have no default — docker-compose refuses to start
# without them.
# =============================================================================

# --- Database (PostgreSQL) ---
DB_USER=tf_user
DB_PASSWORD=                      # REQUIRED
DB_NAME=terraform_dashboard
# Only used when running the backend outside docker-compose; inside compose the
# backend builds DATABASE_URL from DB_USER / DB_PASSWORD / DB_NAME.
DATABASE_URL=postgresql+asyncpg://tf_user:changeme@localhost:5432/terraform_dashboard

# --- Redis ---
REDIS_PASSWORD=                   # REQUIRED
# Only used outside compose; inside compose REDIS_URL is built with the password.
REDIS_URL=redis://localhost:6379/0

# --- MinIO (Terraform S3 state backend + version snapshots) ---
# Also passed to the backend as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=                  # REQUIRED
MINIO_ROOT_PASSWORD=              # REQUIRED

# --- Environment & host ---
# TF_ENV: "dev" or "prod". AUTH_DISABLED is only tolerated when TF_ENV=dev AND
# DASHBOARD_HOSTNAME is localhost/127.0.0.1/0.0.0.0 — otherwise the backend
# refuses to start. Set TF_ENV=prod on any real deployment.
TF_ENV=dev
DASHBOARD_HOSTNAME=localhost

# --- CORS (comma-separated list of allowed frontend origins) ---
# Wildcards, "*" and "null" are rejected at startup. List explicit origins.
CORS_ORIGINS=http://localhost:5173

# --- SSL verification for outgoing requests (VCD, Keycloak) ---
# Set to false only for development with self-signed certificates.
VERIFY_SSL=true

# --- Authentication ---
# Set to true to disable Keycloak auth entirely (local testing only — see TF_ENV).
AUTH_DISABLED=false

# --- Keycloak SSO ---
KEYCLOAK_URL=https://sso-ttc.t-cloud.kz
KEYCLOAK_REALM=prod-v1
KEYCLOAK_CLIENT_ID=terraform-dashboard
KEYCLOAK_CLIENT_SECRET=

# --- Frontend Keycloak (same values, baked in at build time by Vite) ---
VITE_AUTH_DISABLED=false
VITE_KEYCLOAK_URL=https://sso-ttc.t-cloud.kz
VITE_KEYCLOAK_REALM=prod-v1
VITE_KEYCLOAK_CLIENT_ID=terraform-dashboard

# --- VMware Cloud Director (CloudAPI — dashboard metadata) ---
VCD_URL=https://vcd.example.com
VCD_API_TOKEN=
VCD_API_VERSION=38.0
VCD_ORG=System

# --- VCD Terraform provider credentials ---
# Injected as TF_VAR_vcd_user / TF_VAR_vcd_password. Never written into HCL.
VCD_USER=terraform-svc
VCD_PASSWORD=

# --- Secondary VCD (cloud-to-cloud migration destination) ---
# Leave SECONDARY_VCD_URL empty to disable all second-cloud features.
# Example: primary = vcd05.t-cloud.kz (source), secondary = vcd.t-cloud.kz (target).
SECONDARY_VCD_URL=
SECONDARY_VCD_API_TOKEN=
SECONDARY_VCD_API_VERSION=38.0
SECONDARY_VCD_ORG=System
SECONDARY_VCD_USER=
SECONDARY_VCD_PASSWORD=
SECONDARY_VCD_LABEL=Secondary VCD

# --- NSX-T (optional) ---
NSXT_URL=
NSXT_USER=
NSXT_PASSWORD=

# --- vSphere (optional, not yet used in templates) ---
VSPHERE_URL=
VSPHERE_USER=
VSPHERE_PASSWORD=

# --- Terraform ---
TERRAFORM_BINARY=/usr/local/bin/terraform
TF_STATE_BACKEND=pg
TF_WORKSPACE_BASE=/tmp/tf-workspaces
WORKSPACE_CLEANUP_ENABLED=true

# --- Local terraform provider mirror ---
# Set when the host cannot reach registry.terraform.io. Expects the layout
# <dir>/registry.terraform.io/<namespace>/<type>/<version>/<os>_<arch>/
# Empty means providers are fetched from the registry as usual.
TF_PROVIDER_MIRROR_DIR=

# --- Egress proxy (only if the host uses one) ---
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- Drift sync (daily reconcile of deployments against VCD) ---
DRIFT_SYNC_ENABLED=true
DRIFT_SYNC_CRON=0 3 * * *
DRIFT_SYNC_TIMEZONE=Asia/Almaty
DRIFT_SYNC_LOCK_TTL=1800

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend build ---
# Empty means the frontend calls the API through the same origin (nginx proxy).
VITE_API_URL=
